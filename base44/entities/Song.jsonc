{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_slug": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "original_key": {
      "type": "string"
    },
    "capo": {
      "type": "number",
      "default": 0
    },
    "tuning": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "F\u00e1cil",
        "Intermedia",
        "Avanzada"
      ]
    },
    "language": {
      "type": "string"
    },
    "has_chords": {
      "type": "boolean",
      "default": false
    },
    "has_tablature": {
      "type": "boolean",
      "default": false
    },
    "content_raw": {
      "type": "string"
    },
    "tablature": {
      "type": "string"
    },
    "chords_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "default": "published"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "is_trending": {
      "type": "boolean",
      "default": false
    },
    "is_hero": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "spotify_embed": {
      "type": "string"
    },
    "spotify_track_id": {
      "type": "string"
    },
    "spotify_uri": {
      "type": "string"
    },
    "spotify_url": {
      "type": "string"
    },
    "spotify_embed_url": {
      "type": "string"
    },
    "spotify_track_name": {
      "type": "string"
    },
    "spotify_artist_name": {
      "type": "string"
    },
    "spotify_album_name": {
      "type": "string"
    },
    "spotify_duration_ms": {
      "type": "number"
    },
    "spotify_isrc": {
      "type": "string"
    },
    "spotify_match_score": {
      "type": "number"
    },
    "spotify_match_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "matched",
        "review_required",
        "not_found",
        "error",
        "disabled"
      ],
      "default": "pending"
    },
    "spotify_match_method": {
      "type": "string",
      "enum": [
        "isrc",
        "exact_artist_title",
        "fuzzy_artist_title",
        "manual",
        "existing_url"
      ]
    },
    "spotify_last_sync": {
      "type": "string"
    },
    "spotify_sync_error": {
      "type": "string"
    },
    "spotify_manual_lock": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "slug",
    "artist_name",
    "artist_slug"
  ]
}