{
  "name": "AmazonProduct",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "affiliate_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Guitarras",
        "Amplificadores",
        "Accesorios",
        "Cuerdas",
        "Efectos",
        "Libros"
      ]
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "affiliate_url"
  ]
}