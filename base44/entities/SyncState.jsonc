{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "page_token": {
      "type": "string"
    },
    "folder_id": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string"
    },
    "total_files": {
      "type": "number",
      "default": 0
    },
    "processed_files": {
      "type": "number",
      "default": 0
    },
    "error_files": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "default": "idle"
    },
    "last_error": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}