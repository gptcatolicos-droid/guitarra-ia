        "user"
      ]
    },
    "admin_role": {
      "type": "string",
      "description": "Administrative role within the admin panel. Only Super Admin can manage users and settings.",
      "enum": [
        "Super Admin",
        "Administrador",
        "Editor",
        "Autor"
      ]
    }
  },
  "required": [
