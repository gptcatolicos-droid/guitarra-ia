{
  "name": "Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "normalized_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "biography_short": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "image_url": {
      "type": "string"
    },
    "spotify_artist_url": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}