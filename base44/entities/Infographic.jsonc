{
  "name": "Infographic",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seo_title": {
      "type": "string"
    },
    "seo_meta_description": {
      "type": "string",
      "maxLength": 1000
    },
    "seo_alt_text": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "slug",
    "image_urls"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}